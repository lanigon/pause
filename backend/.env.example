# ═══════════════════════════════════════════════════════════════
#  只有两个环境变量，而且都可以不填。
#  端口、路径、超时全在代码里（src/config/env.ts）。
#  JWT 密钥每次启动随机生成。
#  GPG 口令/PIN 由本机的 gpg-agent 负责，不在这里配。
# ═══════════════════════════════════════════════════════════════

# RPC 三级降级的第二级：Lark → Alchemy → ChainList
# 不填就只用 Lark 和 ChainList 的公开 RPC。
ALCHEMY_API_KEY=

# 飞书多维表格链接（一张表四列：业务线 / 链 / RPC / 合约）。
# **直接贴浏览器地址栏里的完整链接**，app token 和 table id 由代码自己解，不用手抠。
#   https://xxx.feishu.cn/base/<appToken>?table=<tableId>&view=<viewId>
# 注意要点开具体那张表再复制 —— 只到多维表格首页的链接没有 ?table= 参数。
#
# 填了之后，前端每次加载数据后端都会先跟这张表对一遍，有差异才更新本地。
# 需要本机装好 lark CLI 并登录；不填就跳过同步，只用 data/ 下的本地数据。
LARK_URL=
