# ═══════════════════════════════════════════════════════════════
#  三个环境变量，都可以不填 —— 但第三个在特定场景下必须填。
#
#  端口、路径、超时全在代码里（src/config/env.ts）。
#  JWT 密钥生产环境每次启动随机生成，开发环境缓存在 secrets/.jwt-dev。
#  GPG 口令 / PIN 由本机的 gpg-agent + pinentry 负责，不在这里配。
#  飞书表格地址在 data/sync.json —— 那是团队共享配置，不是密钥。
# ═══════════════════════════════════════════════════════════════

# RPC 三级降级的第二级：Lark → Alchemy → ChainList
# 不填就只用 Lark 和 ChainList 的公开 RPC。
ALCHEMY_API_KEY=

# gpg 可执行文件。默认就是 PATH 里的 gpg，装在别处才需要填。
GPG_BINARY=

# 自定义 GnuPG 密钥环的位置（默认 ~/.gnupg）。
#
# ⚠️ 用 YubiKey 或独立密钥环时**必须设对**。
#    不设的话 gpg 会去找默认密钥环，永远解不开 ——
#    而报出来的错看起来像「口令错」，很容易查错方向。
#
# ⚠️ 路径别太长：gpg-agent 的 socket 走 Unix domain socket，
#    路径超长会直接起不来。npm run check 会替你量一下。
GNUPGHOME=
