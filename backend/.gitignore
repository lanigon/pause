# ── 依赖与构建产物 ──────────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# ── 密钥材料（最重要的一段，别动）─────────────────────────────────────
# secrets/ 下是 GPG 加密的运维私钥；后三条是兜底，
# 防止密钥文件被放到目录外面还被 add 进来。
secrets/
*.gpg
*.asc
*.key
*.pem

# ── 环境变量 ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── 运行时数据 ──────────────────────────────────────────────────────────
# data/ 下的配置类 json（chains / contracts / operators / signers / rpc）要入库，
# 只有操作日志是运行时产物。
data/operations.json

# ── 测试与日志产物 ──────────────────────────────────────────────────────
coverage/
*.log
logs/

# ── 本地联调脚本 ────────────────────────────────────────────────────────
# 这几个是手工对接后端用的一次性脚本，里面写死了测试私钥，不要入库。
# 新加的临时脚本请用 *.local.ts 命名，会被下面这条自动挡住。
t.ts
t2.ts
sp.ts
*.local.ts

# ── 编辑器 / 系统 ───────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
