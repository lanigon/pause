# 各子项目自己还有一份 .gitignore（backend/ 与 frontend/），这里只放跨项目的。

# ── 依赖与构建产物 ──────────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# ── 密钥材料（兜底，backend/.gitignore 里还有一份）─────────────────────
secrets/
*.gpg
*.asc
*.key
*.pem

# ── 环境变量 ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── 工具产物 ────────────────────────────────────────────────────────────
.playwright-mcp/
coverage/
playwright-report/
test-results/
*.log
logs/

# ── 编辑器 / 系统 ───────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
