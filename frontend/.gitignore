# ── 依赖与构建产物 ──────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# ── 环境变量 ────────────────────────────────────────────────────────────
# 注意 Vite 会把 VITE_ 前缀的变量打进前端产物，
# 所以这里本来就不该放任何密钥；忽略它们只是防止本地地址覆盖别人的。
.env
.env.*
!.env.example
*.local

# ── 测试与日志产物 ──────────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
*.log
logs/

# ── 编辑器 / 系统 ───────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
